* text=auto
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Preserve unified-diff context lines in external-checkout patches.
docs/development/patches/*.patch -text whitespace=-blank-at-eol,-blank-at-eof
# Native CAD files retain their original line endings.
auriga/robot/model/robot_information_data/*/cad/*.STEP -text whitespace=cr-at-eol
